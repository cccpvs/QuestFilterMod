@page "/questfiltermod/random"
@using MudBlazor
@using QuestFilterMod.RandomQuests.Models
@using System.Linq
@using System.Text.Json

@layout BaseMudBlazorLayout
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Random Quest Config</PageTitle>

<div class="spt-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

        <!-- ====== NAVIGATION ====== -->
        <Nav Current="random" />

        <MudPaper Elevation="0" Class="spt-panel hero pa-4 mb-4">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="3">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Casino" Color="Color.Success" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h5" Class="spt-title">Random Quest Config</MudText>
                        <MudText Typo="Typo.caption" Class="spt-muted">RandomQuestConfig.json</MudText>
                    </div>
                </MudStack>
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    @if (_dirty)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Unsaved changes</MudChip>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveConfiguration">Save</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
        <MudTabs @bind-ActiveIndex="_activeTab" PanelClass="pa-4">
            <MudTabPanel Text="Quest Gen" ItemText="Quest Gen">
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Class="mr-2" />
                        Quest Types
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_config.QuestGeneration.Types.Exploration" Label="Exploration" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Class="spt-muted mt-1">Find and interact with objects/locations</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_config.QuestGeneration.Types.Delivery" Label="Delivery" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Class="spt-muted mt-1">Deliver an item to a location</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_config.QuestGeneration.Types.Beacon" Label="Beacon" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Class="spt-muted mt-1">Place a beacon at a location</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_config.QuestGeneration.Types.Kills" Label="Kills" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Class="spt-muted mt-1">Kill enemies</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_config.QuestGeneration.Types.Transfer" Label="Transfer" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Class="spt-muted mt-1">Transfer items to a location</MudText>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_config.QuestGeneration.Types.Combo" Label="Combo" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Class="spt-muted mt-1">Combo quest (multiple conditions)</MudText>
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="mt-4 mb-4" />
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Map" Class="mr-2" />
                        Allowed Locations
                    </MudText>
                    <MudGrid>
                        @foreach (var toggle in _locationToggles)
                        {
                            <MudItem xs="6" md="4" lg="3">
                                <MudSwitch @bind-Value="toggle.Enabled" Label="@toggle.Name" Color="Color.Primary" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Exploration" ItemText="Exploration">
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <MudSwitch @bind-Value="_config.ExplorationQuest.Survive" Label="Survive requirement" Color="Color.Primary" Class="mb-4" />
                    <MudAlert Color="Color.Info" Variant="Variant.Text" Dense="true">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        Location targets are configured directly in RandomQuestConfig.json. This section requires manual editing.
                    </MudAlert>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Delivery" ItemText="Delivery">
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <MudSwitch @bind-Value="_config.DeliveryQuest.StartItem" Label="Start Item" Color="Color.Primary" Class="mb-2" />
                    <MudNumericField @bind-Value="_config.DeliveryQuest.PlantTime" Label="Plant Time (ms)" Variant="Variant.Outlined" Dense="true" Class="mb-4" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Item Plant IDs</MudText>
                    <div class="chips">
                        @foreach (var id in _deliveryItemPlantIds)
                        {
                            <MudChip T="string" Color="Color.Default" OnClose="() => RemoveDeliveryItemPlant(id)">
                                @id
                            </MudChip>
                        }
                    </div>
                    <MudStack Row Spacing="2" Class="mt-2">
                        <MudTextField @bind-Value="_newDeliveryItemPlant" Variant="Variant.Outlined" Dense="true" Placeholder="Add item plant ID" />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddDeliveryItemPlant">
                            <MudIcon Icon="@Icons.Material.Outlined.Add" />
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="spt-muted mt-1">Template IDs of items to be delivered</MudText>
                    <MudDivider Class="mt-4 mb-4" />
                    <MudAlert Color="Color.Info" Variant="Variant.Text" Dense="true">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        Location targets are configured directly in RandomQuestConfig.json. This section requires manual editing.
                    </MudAlert>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Beacon" ItemText="Beacon">
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <MudSwitch @bind-Value="_config.BeaconQuest.StartItem" Label="Start Item" Color="Color.Primary" Class="mb-2" />
                    <MudNumericField @bind-Value="_config.BeaconQuest.PlantTime" Label="Plant Time (ms)" Variant="Variant.Outlined" Dense="true" Class="mb-2" />
                    <MudDivider Class="mt-4 mb-4" />
                    <MudAlert Color="Color.Info" Variant="Variant.Text" Dense="true">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                        Location targets are configured directly in RandomQuestConfig.json. This section requires manual editing.
                    </MudAlert>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Kill" ItemText="Kill">
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudNumericField @bind-Value="_config.KillQuest.MinKills" Label="Min Kills" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField @bind-Value="_config.KillQuest.MaxKills" Label="Max Kills" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Target Types</MudText>
                    <div class="chips">
                        @foreach (var target in _killTargets)
                        {
                            <MudChip T="string" Color="Color.Default" OnClose="() => RemoveKillTarget(target)">
                                @target
                            </MudChip>
                        }
                    </div>
                    <MudStack Row Spacing="2" Class="mt-2">
                        <MudTextField @bind-Value="_newKillTarget" Variant="Variant.Outlined" Dense="true" Placeholder="Add target" />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddKillTarget">
                            <MudIcon Icon="@Icons.Material.Outlined.Add" />
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="spt-muted mt-1">Any, AnyPmc, Savage, Usec, Bear</MudText>
                    <MudDivider Class="mt-4 mb-4" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Time of Day</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_config.KillQuest.TimeDay.Enable" Label="Enable" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_timeDayMinimalText" Label="Minimal (hour, minute)" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_config.KillQuest.TimeDay.Interval" Label="Interval (hours)" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="mt-4 mb-4" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Weapons</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_config.KillQuest.Weapons.Enable" Label="Enable Weapon Filter" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_config.KillQuest.Weapons.Started" Label="Started Item" Color="Color.Primary" />
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2">Weapon IDs</MudText>
                    <div class="chips">
                        @foreach (var id in _killWeaponIds)
                        {
                            <MudChip T="string" Color="Color.Default" OnClose="() => RemoveKillWeaponId(id)">
                                @id
                            </MudChip>
                        }
                    </div>
                    <MudStack Row Spacing="2" Class="mt-2">
                        <MudTextField @bind-Value="_newKillWeaponId" Variant="Variant.Outlined" Dense="true" Placeholder="Add weapon ID" />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddKillWeaponId">
                            <MudIcon Icon="@Icons.Material.Outlined.Add" />
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Transfer" ItemText="Transfer">
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_transferItemCountText" Label="Item Count (min, max)" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_transferConditionText" Label="Condition (min, max)" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Item IDs</MudText>
                    <div class="chips">
                        @foreach (var id in _transferItemIds)
                        {
                            <MudChip T="string" Color="Color.Default" OnClose="() => RemoveTransferItemId(id)">
                                @id
                            </MudChip>
                        }
                    </div>
                    <MudStack Row Spacing="2" Class="mt-2">
                        <MudTextField @bind-Value="_newTransferItemId" Variant="Variant.Outlined" Dense="true" Placeholder="Add item ID" />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddTransferItemId">
                            <MudIcon Icon="@Icons.Material.Outlined.Add" />
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="spt-muted mt-1">Template IDs of items to be transferred</MudText>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Combo" ItemText="Combo">
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_comboConditionsText" Label="Conditions (min, max)" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSwitch @bind-Value="_config.ComboQuest.Location" Label="Location-based" Color="Color.Primary" />
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Quest Types</MudText>
                    <div class="chips">
                        @foreach (var type in _comboTypes)
                        {
                            <MudChip T="string" Color="Color.Default" OnClose="() => RemoveComboType(type)">
                                @type
                            </MudChip>
                        }
                    </div>
                    <MudStack Row Spacing="2" Class="mt-2">
                        <MudTextField @bind-Value="_newComboType" Variant="Variant.Outlined" Dense="true" Placeholder="Add type" />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddComboType">
                            <MudIcon Icon="@Icons.Material.Outlined.Add" />
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="spt-muted mt-1">Exploration, Delivery, Beacon, Kills, Transfer</MudText>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Rewards" ItemText="Rewards">
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <!-- Money Reward -->
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="mr-2" />
                        Money Reward
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_config.RewardMoney.Enabled" Label="Enabled" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_rewardMoneyTpl" Label="Money Template (TPL)" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_config.RewardMoney.Min" Label="Min" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_config.RewardMoney.Max" Label="Max" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_config.RewardMoney.Step" Label="Step" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="mt-4 mb-4" />

                    <!-- Items Reward -->
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="mr-2" />
                        Items Reward
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_config.RewardItems.Enabled" Label="Enabled" Color="Color.Primary" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Count Range</MudText>
                            <MudNumericField @bind-Value="_config.RewardItems.Count.Min" Label="Min" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField @bind-Value="_config.RewardItems.Count.Max" Label="Max" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Price Range</MudText>
                            <MudNumericField @bind-Value="_config.RewardItems.PriceRange.Min" Label="Min" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField @bind-Value="_config.RewardItems.PriceRange.Max" Label="Max" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="mt-4 mb-4" />

                    <!-- Parents -->
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Class="mr-2" />
                        Item Parents (with weights)
                    </MudText>
                    @foreach (var item in _parentItems)
                    {
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="item.Id" Label="Parent ID" Variant="Variant.Outlined" Dense="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField @bind-Value="item.Weight" Label="Weight" Variant="Variant.Outlined" Dense="true" Min="1" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="item.Id" Label="Comment" Variant="Variant.Outlined" Dense="true" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveParent(_parentItems.IndexOf(item))">
                                    <MudIcon Icon="@Icons.Material.Filled.Delete" /> Remove
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    }
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddParent" Class="mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1" /> Add Parent
                    </MudButton>
                    <MudDivider Class="mt-4 mb-4" />

                    <!-- Default Quest -->
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Image" Class="mr-2" />
                        Default Quest Icon
                    </MudText>
                    <MudTextField @bind-Value="_config.DefaultQuest.Image" Label="Image Path" Variant="Variant.Outlined" Dense="true" />

                    <MudDivider Class="mt-4 mb-4" />

                    <!-- Trader Standing -->
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Star" Class="mr-2" />
                        Trader Standing Reward
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudSwitch @bind-Value="_config.RewardTraderStanding.Enabled" Label="Enabled" Color="Color.Primary" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudNumericField @bind-Value="_config.RewardTraderStanding.Min" Label="Min" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField @bind-Value="_config.RewardTraderStanding.Max" Label="Max" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="mt-4 mb-4" />

                    <!-- Experience -->
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Explore" Class="mr-2" />
                        Experience Reward
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_config.ExperienceRewardRange.Min" Label="Min" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_config.ExperienceRewardRange.Max" Label="Max" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_config.ExperienceRewardRange.Step" Label="Step" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudDivider Class="mt-4 mb-4" />

                    <!-- Skills -->
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-2" />
                        Skill Rewards
                    </MudText>
                    <MudGrid>
                        <MudItem xs="12" md="3">
                            <MudSwitch @bind-Value="_config.RewardSkills.Enabled" Label="Enabled" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudNumericField @bind-Value="_config.RewardSkills.Count" Label="Skill Count" Variant="Variant.Outlined" Dense="true" Min="1" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudNumericField @bind-Value="_config.RewardSkills.Value" Label="Value" Variant="Variant.Outlined" Dense="true" />
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Skills</MudText>
                    <div class="chips">
                        @foreach (var skill in _skillNames)
                        {
                            <MudChip T="string" Color="Color.Default" OnClose="() => RemoveSkill(skill)">
                                @skill
                            </MudChip>
                        }
                    </div>
                    <MudStack Row Spacing="2" Class="mt-2">
                        <MudTextField @bind-Value="_newSkillName" Variant="Variant.Outlined" Dense="true" Placeholder="Add skill name" />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddSkill">
                            <MudIcon Icon="@Icons.Material.Outlined.Add" />
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="Traders" ItemText="Traders">
                <MudPaper Elevation="0" Class="spt-panel pa-4">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
                        Trader IDs
                    </MudText>
                    <div class="chips">
                        @foreach (var id in _traderIds)
                        {
                            <MudChip T="string" Color="Color.Default" OnClose="() => RemoveTraderId(id)">
                                @id
                            </MudChip>
                        }
                    </div>
                    <MudStack Row Spacing="2" Class="mt-2">
                        <MudTextField @bind-Value="_newTraderId" Variant="Variant.Outlined" Dense="true" Placeholder="Add trader ID" />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="AddTraderId">
                            <MudIcon Icon="@Icons.Material.Outlined.Add" />
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="spt-muted mt-2">
                        <ul class="list-unstyled">
                            <li><code>54cb50c76803fa8b248b4571</code> — Prapor</li>
                            <li><code>54cb57776803fa99248b456e</code> — Therapist</li>
                            <li><code>579dc571d53a0658a154fbec</code> — Fence</li>
                            <li><code>58330581ace78e27b8b10cee</code> — Skier</li>
                            <li><code>5935c25fb3acc3127c3d8cd9</code> — Peacekeeper</li>
                            <li><code>5a7c2eca46aef81a7ca2145d</code> — Mechanic</li>
                            <li><code>5ac3b934156ae10c4430e83c</code> — Ragman</li>
                            <li><code>5c0647fdd443bc2504c2d371</code> — Jaeger</li>
                            <li><code>6617beeaa9cfa777ca915b7c</code> — Ref</li>
                        </ul>
                    </MudText>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
        <MudStack Row Justify="Justify.SpaceBetween" Class="mt-4">
            <MudButton Variant="Variant.Text" OnClick="LoadDefaults">
                <MudIcon Icon="@Icons.Material.Filled.Restore" Class="mr-1" />
                Reset to Defaults
            </MudButton>
            <MudText Typo="Typo.caption" Class="spt-muted">Changes apply immediately. Click Save to persist.</MudText>
        </MudStack>
    </MudContainer>
</div>

@code {
    private QuestConfig _config = new();
    private bool _dirty;
    private int _activeTab;

    // --- Временные поля для строк ---
    private string _timeDayMinimalText = "";
    private string _transferItemCountText = "";
    private string _transferConditionText = "";
    private string _comboConditionsText = "";
    private string _rewardMoneyTpl = "";

    // --- Delivery Item Plant ---
    private List<string> _deliveryItemPlantIds = new();
    private string _newDeliveryItemPlant = "";

