    private void SyncTempVars()
    {
        if (_config.KillQuest?.TimeDay != null)
            _timeDayMinimalText = string.Join(", ", _config.KillQuest.TimeDay.Minimal);
        if (_config.TransferQuest?.ItemCount != null)
            _transferItemCountText = string.Join(", ", _config.TransferQuest.ItemCount);
        if (_config.TransferQuest?.Condition != null)
            _transferConditionText = string.Join(", ", _config.TransferQuest.Condition);
        if (_config.ComboQuest?.Conditions != null)
            _comboConditionsText = string.Join(", ", _config.ComboQuest.Conditions);
        _rewardMoneyTpl = _config.RewardMoney?.Tpl ?? "";
        _parentItems = _config.RewardItems?.Parents?.Select(p => new ParentItem { Id = p.Id, Weight = p.Weight, Comment = p.Comment }).ToList() ?? new();
        _killTargets = _config.KillQuest?.Target?.ToList() ?? new();
        _killWeaponIds = _config.KillQuest?.Weapons?.Ids ?? new();
        _transferItemIds = _config.TransferQuest?.ItemIds ?? new();
        _comboTypes = _config.ComboQuest?.Type?.ToList() ?? new();
        _traderIds = _config.TraderIds ?? new();
        _skillNames = _config.RewardSkills?.Skill?.ToList() ?? new();
        _deliveryItemPlantIds = _config.DeliveryQuest?.ItemPlant?.ToList() ?? new();
        _locationToggles = new();
        if (_config.QuestGeneration?.AllowedLocations != null)
            foreach (var kvp in _config.QuestGeneration.AllowedLocations)
                _locationToggles.Add(new LocationToggle { Name = kvp.Key, Enabled = kvp.Value });
    }

    private void LoadFromJson()
    {
        var configPath = System.IO.Path.Combine(
            System.IO.Path.GetDirectoryName(System.Reflection.Assembly.GetExecutingAssembly().Location)!,
            "RandomQuestConfig.json");

        if (!File.Exists(configPath))
        {
            InitDefaults();
            return;
        }

        try
        {
            var json = File.ReadAllText(configPath);
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            _config = JsonSerializer.Deserialize<QuestConfig>(json, options) ?? new QuestConfig();
        }
        catch
        {
            InitDefaults();
        }
    }

    // --- Сохранение конфига ---
    private async Task SaveConfiguration()
    {
        try
        {
            // Синхронизируем строки с массивами
            _config.KillQuest.TimeDay.Minimal = ParseIntArray(_timeDayMinimalText);
            _config.TransferQuest.ItemCount = ParseIntArray(_transferItemCountText);
            _config.TransferQuest.Condition = ParseIntArray(_transferConditionText);
            _config.ComboQuest.Conditions = ParseIntArray(_comboConditionsText);
            _config.RewardMoney.Tpl = _rewardMoneyTpl;
            _config.KillQuest.Target = _killTargets.ToArray();
            _config.KillQuest.Weapons.Ids = _killWeaponIds;
            _config.TransferQuest.ItemIds = _transferItemIds;
            _config.ComboQuest.Type = _comboTypes.ToArray();
            _config.TraderIds = _traderIds;
            _config.RewardSkills.Skill = _skillNames.ToArray();
            _config.DeliveryQuest.ItemPlant = _deliveryItemPlantIds.ToList();

            // Синхронизируем allowed locations
            _config.QuestGeneration.AllowedLocations = _locationToggles.ToDictionary(t => t.Name, t => t.Enabled);

            // Обновляем ID родителей из wrapper-списка
            for (int i = 0; i < _parentItems.Count && i < _config.RewardItems.Parents.Length; i++)
            {
                _config.RewardItems.Parents[i].Id = _parentItems[i].Id;
                _config.RewardItems.Parents[i].Weight = _parentItems[i].Weight;
                _config.RewardItems.Parents[i].Comment = _parentItems[i].Comment;
            }

            var json = JsonSerializer.Serialize(_config, new JsonSerializerOptions { WriteIndented = true });

            var configPath = System.IO.Path.Combine(
                System.IO.Path.GetDirectoryName(System.Reflection.Assembly.GetExecutingAssembly().Location)!,
                "RandomQuestConfig.json");

            File.WriteAllText(configPath, json);

            _dirty = false;
            Snackbar.Add("RandomQuestConfig saved successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving: {ex.Message}", Severity.Error);
        }
    }

