    private void MarkDirty() => _dirty = true;

    // --- Парсинг int[] ---
    private static int[] ParseIntArray(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return [];
        return text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                   .Select(int.Parse)
                   .ToArray();
    }

    // --- Parents ---
    private void AddParent()
    {
        var newParents = _config.RewardItems.Parents.Concat(new[] { new ParentWeight { Id = "", Weight = 1, Comment = "" } }).ToArray();
        _config.RewardItems.Parents = newParents;
        _parentItems.Add(new ParentItem { Id = "", Comment = "" });
        MarkDirty();
    }

    private void RemoveParent(int index)
    {
        var newParents = _config.RewardItems.Parents.Where((_, i) => i != index).ToArray();
        _config.RewardItems.Parents = newParents;
        _parentItems.RemoveAt(index);
        MarkDirty();
    }

    // --- Парсинг string[] ---
    private static string[] ParseStringArray(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return [];
        return text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                   .ToArray();
    }

