    // --- Синхронизация строк с int[] ---
    private void SyncTempVars()
    {
        _linkedStartText = _config.LinkedQuest?.StartQuest != null
            ? string.Join(", ", _config.LinkedQuest.StartQuest)
            : "";
        _linkedFinishText = _config.LinkedQuest?.QuestFinish != null
            ? string.Join(", ", _config.LinkedQuest.QuestFinish)
            : "";
        _countCondText = _config.ModifyBaseQuest?.CountCond != null
            ? string.Join(", ", _config.ModifyBaseQuest.CountCond)
            : "";
    }

    // --- Парсинг int[] ---
    private static int[] ParseIntArray(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return [];
        return text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                   .Select(int.Parse)
                   .ToArray();
    }

    // --- Сброс ---
    private void LoadDefaults()
    {
        InitDefaults();
        SyncTempVars();
        _dirty = false;
        Snackbar.Add("Reset to defaults", Severity.Warning);
    }

