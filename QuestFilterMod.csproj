<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  
    <TargetFramework>net9.0</TargetFramework>

    <!-- 🔹 Язык C# 10+ (достаточно для SPT) -->
    <LangVersion>12.0</LangVersion>

    <!-- 🔹 Только твой DLL -->
    <AssemblyName>QuestFilterMod</AssemblyName>
    <RootNamespace>QuestFilterMod</RootNamespace>

    <!-- 🔹 Библиотека -->
    <OutputType>Library</OutputType>

    <!-- 🔹 Версия мода -->
    <Version></Version>

    <!-- 🔹 Путь вывода (например, для spt build) -->
    <OutputPath>bin\$(Configuration)\$(TargetFramework)\</OutputPath>

    <!-- 🔹 Не добавляй платформу в путь -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- 🔹 x64 только! -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- 🔹 Не копировать зависимости! -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- 🔹 Не генерировать AssemblyInfo (SPT CLI сам добавит) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- 🔥 Не копировать ручные ссылки (.dll) -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <!-- 🔹 Современные фичи -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyVersion></AssemblyVersion>
    <FileVersion></FileVersion>
  </PropertyGroup>

